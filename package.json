{
  "name": "map-sprite",
  "version": "0.1.2",
  "description": "Framework-independent TypeScript utilities for generating MapLibre and Mapbox sprite assets from SVG icons.",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "main": "./dist/map-sprite.umd.cjs",
  "module": "./dist/map-sprite.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/map-sprite.js",
      "require": "./dist/map-sprite.umd.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite examples/react-basic --host 127.0.0.1 --config vite.config.ts",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "maplibre",
    "mapbox",
    "sprite",
    "svg",
    "canvas"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mapseekai/map-sprite.git"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "maxrects-packer": "^2.7.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  }
}
